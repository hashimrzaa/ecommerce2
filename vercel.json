{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "version": 2,
    "framework": null,
    "regions": ["sfo1"],
    "buildCommand": "npm run build && rm -rf public/storage && cp -r storage/app/public public/storage",
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.4",
            "maxDuration": 30
        }
    },
    "routes": [
        { "src": "/", "dest": "/api/index.php" },
        { "src": "/index\\.php", "dest": "/api/index.php" },
        { "src": "/build/(.*)", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "continue": true },
        { "src": "/storage/(.*)", "headers": { "Cache-Control": "public, max-age=604800" }, "continue": true },
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "LOG_CHANNEL": "stderr",
        "SESSION_DRIVER": "cookie",
        "SESSION_SECURE_COOKIE": "true",
        "CACHE_STORE": "file",
        "CACHE_FILE_PATH": "/tmp/cache",
        "QUEUE_CONNECTION": "sync",
        "DB_PERSISTENT": "true",
        "STOCK_STALE_HOURS": "0",
        "VIEW_COMPILED_PATH": "/tmp/views",
        "APP_CONFIG_CACHE": "/tmp/config.php",
        "APP_EVENTS_CACHE": "/tmp/events.php",
        "APP_PACKAGES_CACHE": "/tmp/packages.php",
        "APP_ROUTES_CACHE": "/tmp/routes.php",
        "APP_SERVICES_CACHE": "/tmp/services.php"
    }
}
